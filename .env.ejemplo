# Copiar a .env (que no va a git) y completar. Solo hace falta para el chequeo de VPN.
VPN_DIRECCION=xxxx.sn.mynetname.net
# URL del monitor Push de Kuma, cambiando localhost:3100 por kuma:3001
VPN_PUSH_URL=http://kuma:3001/api/push/XXXXXX
# Cada cuántos segundos se chequea (por defecto, una hora)
VPN_INTERVALO=3600
